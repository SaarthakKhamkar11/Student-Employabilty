# Copy to .env (gitignored) and fill in. Never commit real values.
# Used by docker-compose.yml (for the postgres credentials) and by the backend.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. docker compose creates the database with these values.
POSTGRES_USER=employability
POSTGRES_PASSWORD=
POSTGRES_DB=employability
# Must repeat the user, password and database above. "postgres" is the compose
# service name; use localhost:55433 (the host port) when running the backend outside Docker.
DATABASE_URL=postgresql://employability:<POSTGRES_PASSWORD>@postgres:5432/employability

REDIS_URL=redis://redis:6379/0
JWT_SECRET=

# LLM provider (project decision 2026-10-08: Gemini). The Supervisor uses it for routing only
# when BOTH values are set; otherwise it routes deterministically (spec §22).
# GEMINI_MODEL: a current model id from https://ai.google.dev/gemini-api/docs/models
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Free-tier quotas are per model (e.g. 20 requests/day). Models tried in order when the primary returns 429.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=10
